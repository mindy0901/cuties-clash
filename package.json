{
  "name": "martial-cutie",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.22.0",
  "description": "Đấu Trường Thú Cưng — auto-battler nuôi thú cưng trên trình duyệt",
  "scripts": {
    "dev": "pnpm --filter frontend dev",
    "build": "pnpm --filter frontend build",
    "test": "pnpm --filter frontend test",
    "lint": "pnpm -r lint",
    "dev:be": "pnpm --filter backend dev",
    "build:be": "pnpm --filter backend build",
    "test:be": "pnpm --filter backend test",
    "db:up": "docker compose up -d db",
    "db:migrate": "pnpm --filter backend migrate"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0"
  }
}
