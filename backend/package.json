{
  "name": "backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "API đăng nhập Google và đồng bộ tiến trình cho Martial Cutie (Fastify + Prisma)",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "prisma generate && tsc --noEmit",
    "test": "vitest run",
    "migrate": "prisma migrate deploy",
    "generate": "prisma generate",
    "start": "tsx src/main.ts",
    "dev:docker": "nodemon --legacy-watch --watch src --ext ts,json --signal SIGTERM --exec \"tsx src/main.ts\""
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/static": "^10.1.6",
    "@prisma/client": "^6.19.3",
    "fastify": "^5.12.7",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "nodemon": "^3.1.14",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
