# ── Sao chép file này thành .env rồi điền giá trị thật ────────────────────────
#   cp .env.example .env
#
# Backend đọc .env ở thư mục gốc dự án (hoặc backend/.env).

# ── Bắt buộc: khoá ký phiên đăng nhập ─────────────────────────────────────────
# Sinh khoá mới bằng Node (backend là Node/TypeScript):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=doi-thanh-khoa-ngau-nhien-dai-it-nhat-32-ky-tu

# ── Cơ sở dữ liệu ─────────────────────────────────────────────────────────────
# Chạy backend trực tiếp trên máy (không Docker) thì dùng localhost.
# Backend tự bỏ hậu tố driver (`+psycopg`, `+asyncpg`) nếu bạn dán URL kiểu Python vào.
DATABASE_URL=postgresql://martial:martial@localhost:5432/martial_cutie
POSTGRES_USER=martial
POSTGRES_PASSWORD=martial
POSTGRES_DB=martial_cutie
POSTGRES_PORT=5432

# ── Đăng nhập Google ──────────────────────────────────────────────────────────
# https://console.cloud.google.com/auth/clients → Create client → Web application
# Authorized redirect URI phải là:
#   http://localhost:5190/api/auth/google/callback   (dev, qua Vite proxy)
#   http://localhost:8000/api/auth/google/callback   (khi dùng Docker production)
# Cần điền CẢ HAI; thiếu một trong hai thì nút đăng nhập không hiện.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Địa chỉ ───────────────────────────────────────────────────────────────────
# FRONTEND_URL quyết định gốc của điểm gọi lại OAuth → PHẢI khớp redirect URI đã
# đăng ký với Google.
#   Dev Vite (pnpm dev):            http://localhost:5190
#   Docker (docker compose up):     http://localhost:5190  ← service `fr` (nginx)
# Lưu ý: trong Docker, docker-compose.yml KHÔNG lấy giá trị này từ file .env mà
# dùng BE_PUBLIC_URL (cũng mặc định là http://localhost:5190), vì địa chỉ công
# khai của container không phụ thuộc cấu hình dev trên máy.
FRONTEND_URL=http://localhost:5190
# BACKEND_URL chỉ dùng khi gọi API trực tiếp, không qua proxy.
BACKEND_URL=http://localhost:8000

# ── Cổng khi chạy Docker (docker-compose.yml đọc) ─────────────────────────────
# Địa chỉ công khai của game trong Docker — ghi đè FRONTEND_URL của backend.
# Nếu bạn chạy `docker compose --profile dev up db be vite` (frontend là Vite),
# giá trị này vẫn là http://localhost:5190 nên không cần đổi.
BE_PUBLIC_URL=http://localhost:5190
# Cổng công khai của từng service. Đổi cổng frontend thì PHẢI đăng ký lại
# redirect URI ở Google Console cho khớp.
FR_PORT=5190
BE_PORT=8000

# ── Bảo mật cookie ────────────────────────────────────────────────────────────
# Bật true khi chạy sau HTTPS (bắt buộc trên production).
COOKIE_SECURE=false
# Số ngày phiên đăng nhập còn hiệu lực.
SESSION_DAYS=30

# ── Khác ──────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
# true: tự tạo bảng lúc khởi động (tiện cho dev). Production dùng `prisma migrate deploy`
# trong backend/docker-entrypoint.sh.
AUTO_CREATE_TABLES=true
# true: khách chưa đăng nhập được đưa thẳng tới Google thay vì xem phòng chuẩn bị.
# Nên để false nếu bạn muốn người chơi thử game trước. Chỉ có tác dụng khi đã điền
# GOOGLE_CLIENT_ID/SECRET — chưa cấu hình thì game luôn chơi ẩn danh bình thường.
AUTO_LOGIN=false
